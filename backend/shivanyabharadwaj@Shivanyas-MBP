# backend/app.py
import os
import logging
from flask import Flask, jsonify
import docker

LOG_LEVEL = os.getenv("LOG_LEVEL", "INFO").upper()
logging.basicConfig(level=LOG_LEVEL)
logger = logging.getLogger("dockerlens.backend")

# Use env to decide if we should try to connect to docker socket
DOCKER_SOCKET_PATH = os.getenv("DOCKER_SOCKET_PATH", "/var/run/docker.sock")
DOCKER_ENV_MODE = os.getenv("DOCKER_MODE", "auto")  # "auto" or "mock"

app = Flask(__name__)

def get_docker_client():
    if DOCKER_ENV_MODE == "mock":
        logger.info("Docker client: running in MOCK mode (no socket)")
        return None
    # docker.from_env() will attempt to use the socket or DOCKER_HOST env
    try:
        client = docker.from_env()  # uses environment (socket or DOCKER_HOST)
        # simple call to validate
        client.ping()
        logger.info("Connected to Docker daemon")
        return client
    except Exception as e:
        logger.exception("Could not connect to Docker daemon: %s", e)
        return None

docker_client = get_docker_client()

@app.route("/health")
def health():
    ok = True
    details = {"docker": docker_client is not None}
    return jsonify({"status": "ok" if ok else "fail", "details": details})

@app.route("/containers")
def list_containers():
    if docker_client is None:
        # safe fallback - return helpful message
        return jsonify({"error":"docker-unavailable","containers":[]}), 503
    containers = []
    for container in docker_client.containers.list(all=True):
        containers.append({
            'id': container.short_id,
            'name': container.name,
            'status': container.status,
            'image': container.image.tags
        })
    return jsonify(containers)

if __name__ == "__main__":
    # debug only; production uses Gunicorn
    app.run(host="0.0.0.0", port=int(os.getenv("PORT", 5000)), debug=False)

